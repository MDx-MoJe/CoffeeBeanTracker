<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#D84E3110"
                android:centerColor="#CC3E2610"
                android:endColor="#B832180A" />
            <corners android:radius="38dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="38dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#18F5F5F7" />
            <corners android:radius="38dp" />
        </shape>
    </item>
</layer-list>
