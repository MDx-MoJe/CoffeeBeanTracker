<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: very transparent white -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#33FFFFFF"
                android:endColor="#1AFFFFFF"
                android:angle="90" />
            <corners android:radius="38dp" />
        </shape>
    </item>
    <!-- Top highlight -->
    <item android:top="0dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#50FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
            <corners android:topLeftRadius="38dp"
                android:topRightRadius="38dp"
                android:bottomLeftRadius="36dp"
                android:bottomRightRadius="36dp" />
        </shape>
    </item>
    <!-- Glass stroke -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="#806D4C41" />
            <corners android:radius="38dp" />
        </shape>
    </item>
</layer-list>
