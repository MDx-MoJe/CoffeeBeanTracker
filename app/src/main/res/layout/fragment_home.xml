<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ═══ 顶部 Tab：生豆管理 / 熟豆管理 ═══ -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tabGreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/green_bean_tab"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/dock_pill_bg"
            android:textColor="@color/text_secondary"
            android:foreground="@drawable/ripple_coffee_pill"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabRoasted"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/roasted_bean_tab"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/dock_pill_bg"
            android:textColor="@color/text_secondary"
            android:foreground="@drawable/ripple_coffee_pill"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- ═══ 熟豆列表 ═══ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="120dp"
        app:layout_constraintTop_toBottomOf="@id/tabBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/emptyTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tabBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_beans"
            android:textColor="?attr/android:textColorSecondary"
            android:textSize="16sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:maxLines="2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_by_adding"
            android:layout_marginTop="14dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/badge_ready"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- ═══ 生豆列表 ═══ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/greenBeanRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="120dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tabBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/greenBeanEmptyView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tabBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_green_beans"
            android:textColor="?attr/android:textColorSecondary"
            android:textSize="16sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:maxLines="2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_by_adding"
            android:layout_marginTop="14dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/badge_ready"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:textColor="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
