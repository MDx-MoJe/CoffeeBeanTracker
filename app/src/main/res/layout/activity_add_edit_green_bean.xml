<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/add_green_bean"
            app:titleTextColor="@color/white"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- 名称 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/green_bean_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:minHeight="56dp"
                    android:paddingVertical="12dp"
                    android:textSize="17sp"
                    android:textColor="?attr/android:textColorPrimary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 产地 + 豆种 -->
            <LinearLayout
                android:id="@+id/rowOriginVariety"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilName"
                android:weightSum="2">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOrigin"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="@string/origin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOrigin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="56dp"
                        android:paddingVertical="12dp"
                        android:textSize="17sp"
                        android:textColor="?attr/android:textColorPrimary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilVariety"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/bean_variety">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etVariety"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="56dp"
                        android:paddingVertical="12dp"
                        android:textSize="17sp"
                        android:textColor="?attr/android:textColorPrimary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 处理法 + 海拔 -->
            <LinearLayout
                android:id="@+id/rowProcessAltitude"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rowOriginVariety"
                android:weightSum="2">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilProcessMethod"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="@string/process_method">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProcessMethod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="56dp"
                        android:paddingVertical="12dp"
                        android:textSize="17sp"
                        android:textColor="?attr/android:textColorPrimary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAltitude"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/altitude">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAltitude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="56dp"
                        android:paddingVertical="12dp"
                        android:textSize="17sp"
                        android:textColor="?attr/android:textColorPrimary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 等级/品质 + 采收年份 -->
            <LinearLayout
                android:id="@+id/rowGradeHarvest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rowProcessAltitude"
                android:weightSum="2">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilGrade"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="@string/grade">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGrade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="56dp"
                        android:paddingVertical="12dp"
                        android:textSize="17sp"
                        android:textColor="?attr/android:textColorPrimary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilHarvestYear"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/harvest_year">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHarvestYear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="56dp"
                        android:paddingVertical="12dp"
                        android:textSize="17sp"
                        android:textColor="?attr/android:textColorPrimary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 购买日期 -->
            <TextView
                android:id="@+id/tvPurchaseDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                style="@style/FieldLabel"
                android:text="@string/purchase_date"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rowGradeHarvest" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvPurchaseDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPurchaseDateLabel"
                android:foreground="@drawable/ripple_coffee">

                <TextView
                    android:id="@+id/tvPurchaseDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColor="?attr/android:textColorPrimary"
                    android:hint="@string/please_select_date"
                    android:textColorHint="@color/text_hint" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 购买克重 + 剩余克重 -->
            <LinearLayout
                android:id="@+id/rowGrams"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvPurchaseDate"
                android:weightSum="2">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPurchaseGrams"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="@string/purchase_grams">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPurchaseGrams"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:minHeight="56dp"
                        android:paddingVertical="12dp"
                        android:textSize="17sp"
                        android:textColor="?attr/android:textColorPrimary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRemainingGrams"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/remaining_grams">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRemainingGrams"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:minHeight="56dp"
                        android:paddingVertical="12dp"
                        android:textSize="17sp"
                        android:textColor="?attr/android:textColorPrimary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 备注 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNotes"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/extra_notes"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rowGrams">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2"
                    android:maxLines="4"
                    android:textSize="15sp"
                    android:textColor="?attr/android:textColorPrimary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 按钮 -->
            <LinearLayout
                android:id="@+id/buttonContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="28dp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilNotes">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/delete"
                    android:visibility="gone"
                    android:textSize="15sp"
                    android:minHeight="48dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/glass_btn_danger"
                    app:cornerRadius="38dp"
                    app:elevation="6dp"
                    app:rippleColor="#40FFFFFF"
                    android:stateListAnimator="@anim/button_press_anim" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/cancel"
                    android:textSize="15sp"
                    android:minHeight="48dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/glass_btn_outline"
                    app:cornerRadius="38dp"
                    app:elevation="4dp"
                    app:rippleColor="#406D4C41"
                    android:stateListAnimator="@anim/button_press_anim" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/save"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:minHeight="48dp"
                    app:backgroundTint="@null"
                    android:background="@drawable/glass_btn_save_grass_green"
                    app:cornerRadius="38dp"
                    app:elevation="6dp"
                    app:rippleColor="#40000000"
                    android:stateListAnimator="@anim/button_press_anim" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
