<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="7dp"
    android:clipToPadding="false"
    android:foreground="@drawable/ripple_coffee"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/card_bg_warm">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 背景图 + 玻璃层（铺满整卡） -->
        <ImageView
            android:id="@+id/ivBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="false"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/glassOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/glass_overlay"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/llContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- ═══ ① 标题区（铺背景层）═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/title_text_warm"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="15sp"
                        app:autoSizeMaxTextSize="26sp"
                        app:autoSizeStepGranularity="1sp" />

                    <!-- 产地 · 烘焙度 · 处理法 小字（固定字号，超长自动换行） -->
                    <TextView
                        android:id="@+id/tvSubInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="12sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingExtra="1dp"
                        android:textColor="@color/sub_text_warm" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRestBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/crisp_badge_ready"
                    android:textColor="@color/white"
                    android:elevation="2dp"
                    android:foreground="@drawable/ripple_coffee_small"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/days" />

                <TextView
                    android:id="@+id/btnPrint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🖨"
                    android:textSize="16sp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/dock_pill_bg"
                    android:contentDescription="@string/print_label"
                    android:foreground="@drawable/ripple_coffee_pill"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ═══ ② 发展时间 + 风味（浅色圆角框）═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:padding="14dp"
                android:background="@drawable/panel_light_rounded"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/development_time_short"
                        android:textSize="12sp"
                        android:textColor="@color/sub_text_warm" />

                    <TextView
                        android:id="@+id/tvDevelopmentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/title_text_warm" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@color/panel_stroke_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/flavor_notes"
                        android:textSize="12sp"
                        android:textColor="@color/sub_text_warm" />

                    <TextView
                        android:id="@+id/tvFlavorNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/title_text_warm" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ ③ 日期区（铺背景层，水平）═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/roast_date_short"
                        android:textSize="12sp"
                        android:textColor="@color/sub_text_warm" />

                    <TextView
                        android:id="@+id/tvRoastDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/title_text_warm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/best_before_short"
                        android:textSize="12sp"
                        android:textColor="@color/sub_text_warm" />

                    <TextView
                        android:id="@+id/tvBestBefore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/title_text_warm" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ ④ 库存记录区（浅色圆角框）═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/panel_light_rounded">

                <!-- 第一项：剩余克数 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:baselineAligned="false">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stock_remaining"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/sub_text_warm" />

                    <TextView
                        android:id="@+id/tvStockGrams"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="2dp"
                        android:background="@drawable/badge_pour_over"
                        android:foreground="@drawable/ripple_coffee_small"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/stock_grams_unit"
                        android:textSize="16sp"
                        android:textColor="@color/sub_text_warm" />
                </LinearLayout>

                <!-- 第二项：手冲/意式剩余杯数 -->
                <LinearLayout
                    android:id="@+id/llCupsInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:baselineAligned="false">

                    <TextView
                        android:id="@+id/tvCupsPourOver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/badge_pour_over"
                        android:textColor="@color/white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp" />

                    <TextView
                        android:id="@+id/tvCupsEspresso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/badge_espresso"
                        android:textColor="@color/white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <!-- 第三项：做一杯按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPourOver"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:minHeight="46dp"
                        android:paddingVertical="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:text="@string/deduct_pour_over"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/btn_pour_over_ripple"
                        app:backgroundTint="@null"
                        android:backgroundTint="@null"
                        app:elevation="0dp"
                        android:stateListAnimator="@null"
                        app:rippleColor="#33FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEspresso"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:minHeight="46dp"
                        android:paddingVertical="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:text="@string/deduct_espresso"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/title_text_warm"
                        android:background="@drawable/btn_espresso_ripple"
                        app:backgroundTint="@null"
                        android:backgroundTint="@null"
                        app:elevation="0dp"
                        android:stateListAnimator="@null"
                        app:rippleColor="#22000000" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
